HOST=127.0.0.1
PORT=3001
DATABASE_PATH=./data/wishes.sqlite
# Generate with: npm run admin:password (never commit the actual .env)
ADMIN_PASSWORD_HASH=
# Exact public origin for production. Blank uses the request origin locally.
PUBLIC_ORIGIN=
COOKIE_SECURE=false
# Set true ONLY behind the trusted Nginx proxy; bind app to loopback.
TRUST_PROXY=false
